# AI Configuration
# Default: Ollama (Local LLM - Free & Private)
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=codellama
AI_API_KEY=ollama

# Future: OpenAI (Cloud - Requires API Key)
# Uncomment these and comment out Ollama config above to use OpenAI
# AI_API_KEY=your_openai_api_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Elasticsearch Logging
ELASTICSEARCH_NODE=https://english-tracker-app.ddev.site:9201
ELASTICSEARCH_INDEX=ai-api-logs

# MongoDB Configuration
MONGODB_URI=mongodb://root:root@mongodb:27017/english_tracker?authSource=admin

# NextAuth Configuration
NEXTAUTH_URL=https://english-tracker-app.ddev.site
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl_rand_base64_32

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
